{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OABM portable layer selections configuration, schema version 1.0.0",
  "description": "Versioned configuration of named layers with explicit canonical entity membership and named saved presets. This schema covers structure only; duplicate layer/preset ids and names, duplicated members within a layer, a layer assigned two states in one preset, and a preset that does not assign every layer exactly one state are rejected by the Python reader (oabm.model.layers) and by any other strict implementation. Membership references are validated against a concrete canonical model at resolution time, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LayerDefinition"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SavedPreset"
      }
    }
  },
  "$defs": {
    "LayerDefinition": {
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        },
        "system": {
          "$ref": "#/$defs/Label"
        },
        "trade": {
          "$ref": "#/$defs/Label"
        },
        "phase": {
          "$ref": "#/$defs/Label"
        }
      },
      "type": "object"
    },
    "SavedPreset": {
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visible_layer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        },
        "hidden_layer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        },
        "ghosted_layer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        }
      },
      "type": "object"
    },
    "EntityId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "Label": {
      "type": "string",
      "minLength": 1
    }
  }
}
