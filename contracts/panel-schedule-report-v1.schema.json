            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "support_selection_outcomes"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/SupportSelectionOutcome"
              }
            }
          }
        }
      ],
      "properties": {
        "collection": {
          "enum": [
            "box_selection_outcomes",
            "ceilings",
            "circuits",
            "conductors",
            "electrical_boxes",
            "electrical_devices",
            "electrical_equipment",
            "levels",
            "obstacles",
            "openings",
            "ports",
            "raceway_selection_outcomes",
            "raceway_selections",
            "route_constraints",
            "route_fittings",
            "routes",
            "slabs",
            "spaces",
            "support_assemblies",
            "support_components",
            "support_interfaces",
            "support_selection_outcomes",
            "walls"
          ]
        },
        "content_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "entity": {
          "type": "object"
        }
      },
      "required": [
        "collection",
        "entity",
        "content_fingerprint"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/banddude/officeadmin-building-model/contracts/panel-schedule-report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_algorithm": {
      "const": "canonical-entity-order-and-scope-sets-v1"
    },
    "code_verification_performed": {
      "const": false
    },
    "model_source_context": {
      "$ref": "#/$defs/ModelSourceContext"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/PanelFactGroup"
      },
      "type": "array"
    },
    "source_model_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_model_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "source_model_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ]
    },
    "unassigned_circuits": {
      "items": {
        "$ref": "#/$defs/CircuitFactRow"
      },
      "type": "array"
    },
    "version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "version",
    "source_model_id",
    "source_model_version",
    "binding_algorithm",
    "source_model_fingerprint",
    "panels",
    "unassigned_circuits",
    "code_verification_performed",
    "model_source_context"
  ],
  "title": "Supplied panel circuit facts and connected-load completeness",
  "type": "object"
}
