{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual device intake request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "source_sha256",
    "base_model_sha256",
    "frame_id",
    "items"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_item_id"
        ],
        "properties": {
          "source_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "device_type": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "level_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "device_pose": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "rotation"
                ],
                "properties": {
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  },
                  "rotation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z",
                      "w"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "port_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "port_pose": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "rotation"
                ],
                "properties": {
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    }
                  },
                  "rotation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z",
                      "w"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "port_direction": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
