{
  "$defs": {
    "CircuitFactRow": {
      "additionalProperties": false,
      "properties": {
        "assignment_status": {
          "enum": [
            "panel",
            "unsupported_source_owner"
          ]
        },
        "circuit": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "missing_fields": {
          "items": {
            "enum": [
              "circuit_number",
              "poles",
              "phase",
              "voltage_v",
              "load_va"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_owner": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "source_port": {
          "$ref": "#/$defs/SourceSnapshot"
        }
      },
      "required": [
        "circuit",
        "source_port",
        "source_owner",
        "missing_fields",
        "assignment_status"
      ],
      "type": "object"
    },
    "LabelConflict": {
      "additionalProperties": false,
      "properties": {
        "circuit_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "label": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "label",
        "circuit_ids"
      ],
      "type": "object"
    },
    "ModelSourceContext": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "type": "object"
        },
        "content_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "coordinate_system": {
          "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/CoordinateSystem"
        },
        "model_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "name": {
          "type": ["string", "null"]
        },
        "provenance": {
          "items": {
            "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Provenance"
          },
          "type": "array"
        },
        "schema_version": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0"
          ]
        }
      },
      "required": [
        "model_id",
        "schema_version",
        "name",
        "coordinate_system",
        "provenance",
        "attributes",
        "content_fingerprint"
      ],
      "type": "object"
    },
    "PanelFactGroup": {
      "additionalProperties": false,
      "properties": {
        "all_listed_loads_known": {
          "type": "boolean"
        },
        "circuits": {
          "items": {
            "$ref": "#/$defs/CircuitFactRow"
          },
          "type": "array"
        },
        "diagnostic_codes": {
          "items": {
            "enum": [
              "no_listed_circuits",
              "unknown_connected_loads",
              "duplicate_circuit_number"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "known_connected_va": {
          "minimum": 0,
          "type": "number"
        },
        "label_conflicts": {
          "items": {
            "$ref": "#/$defs/LabelConflict"
          },
          "type": "array"
        },
        "panel": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "subtotal_derivation": {
          "const": "inferred"
        },
        "subtotal_source_circuit_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "unknown_load_circuit_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "panel",
        "circuits",
        "known_connected_va",
        "unknown_load_circuit_ids",
        "all_listed_loads_known",
        "label_conflicts",
        "subtotal_derivation",
        "subtotal_source_circuit_ids",
        "diagnostic_codes"
      ],
      "type": "object"
    },
    "SourceSnapshot": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "collection": {
                "const": "levels"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Level"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "spaces"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Space"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "walls"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Wall"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "slabs"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Slab"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "ceilings"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Ceiling"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "openings"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Opening"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "electrical_equipment"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/ElectricalEquipment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "electrical_devices"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/ElectricalDevice"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "ports"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Port"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "obstacles"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Obstacle"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "route_constraints"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/RouteConstraint"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "routes"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Route"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "route_fittings"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/RouteFitting"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "circuits"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Circuit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "conductors"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/Conductor"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "electrical_boxes"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/ElectricalBox"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "box_selection_outcomes"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/BoxSelectionOutcome"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "raceway_selections"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/RacewaySelection"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "raceway_selection_outcomes"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/RacewaySelectionOutcome"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "support_assemblies"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/SupportAssembly"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "support_components"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/SupportComponent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "support_interfaces"
              }
            },
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "entity": {
                "$ref": "https://github.com/banddude/officeadmin-building-model/contracts/oabm-model-v1.3.schema.json#/$defs/SupportInterface"
