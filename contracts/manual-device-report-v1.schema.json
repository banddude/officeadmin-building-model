{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual device intake report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "source_sha256_asserted",
    "base_model_sha256",
    "candidate_model_sha256",
    "request_sha256",
    "frame_id_asserted",
    "items",
    "applied_to_original",
    "source_authentication",
    "registration",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": "manual-device-intake-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_sha256_asserted": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frame_id_asserted": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_item_id",
              "status",
              "device_id",
              "load_port_id"
            ],
            "properties": {
              "source_item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "status": {
                "const": "admitted"
              },
              "device_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "load_port_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_item_id",
              "status",
              "reason",
              "missing_fields"
            ],
            "properties": {
              "source_item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "status": {
                "const": "unresolved"
              },
              "reason": {
                "enum": [
                  "missing_explicit_fields",
                  "individual_placement_required"
                ]
              },
              "missing_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "applied_to_original": {
      "const": false
    },
    "source_authentication": {
      "const": "not_verified"
    },
    "registration": {
      "const": "not_verified"
    },
    "limitations": {
      "type": "array",
      "prefixItems": [
        {
          "const": "Source hash and frame are user assertions, not authenticated or registration proof."
        },
        {
          "const": "No panel, circuit, grouping, route, field condition or code compliance is inferred."
        },
        {
          "const": "Incomplete and quantity-only items are unresolved, not expanded into guessed devices."
        },
        {
          "const": "Device type labels are caller-supplied and not verified against a catalog."
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    }
  }
}
